# 阿里云验证码 2.0 配置
# 在阿里云 RAM 访问控制台创建 AccessKey，并授予 AliyunYundunAFSFullAccess 权限
NUXT_ALIYUN_CAPTCHA_ACCESS_KEY_ID=your_access_key_id
NUXT_ALIYUN_CAPTCHA_ACCESS_KEY_SECRET=your_access_key_secret

# 阿里云验证码场景 ID（在阿里云验证码控制台创建）
NUXT_PUBLIC_ALIYUN_CAPTCHA_SCENE_ID=your_scene_id

# 阿里云验证码前缀（cn 或 overseas）
NUXT_PUBLIC_ALIYUN_CAPTCHA_PREFIX=cn
